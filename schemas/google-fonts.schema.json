{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-ux-pro-max:google-fonts.row",
  "title": "UI/UX Pro Max — google-fonts.csv row",
  "description": "One row of google-fonts.csv (Google Fonts directory export). No numeric No column; some optional fields are blank by design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Family",
    "Category",
    "Stroke",
    "Classifications",
    "Keywords",
    "Styles",
    "Variable Axes",
    "Subsets",
    "Designers",
    "Popularity Rank",
    "Trending Rank",
    "Is Noto",
    "Date Added",
    "Last Modified",
    "Google Fonts URL"
  ],
  "properties": {
    "Family": { "type": "string", "minLength": 1 },
    "Category": { "type": "string", "minLength": 1 },
    "Stroke": { "type": "string", "description": "May be empty for some display families." },
    "Classifications": { "type": "string", "description": "May be empty; when present, classification labels." },
    "Keywords": { "type": "string", "minLength": 1 },
    "Styles": { "type": "string", "minLength": 1 },
    "Variable Axes": { "type": "string", "description": "Often empty for static fonts; axis spec when variable." },
    "Subsets": { "type": "string", "description": "May be empty for a small subset of families." },
    "Designers": { "type": "string", "minLength": 1 },
    "Popularity Rank": { "type": "string", "pattern": "^[0-9]+$" },
    "Trending Rank": { "type": "string", "pattern": "^[0-9]+$" },
    "Is Noto": { "type": "string", "enum": ["No", "Yes"] },
    "Date Added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "Last Modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "Google Fonts URL": { "type": "string", "minLength": 1, "description": "Specimen or share URL on fonts.google.com" }
  }
}
